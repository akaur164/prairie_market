<div style="text-align: center; margin-bottom: 35px;">

  <h1 style="font-size: 38px; margin-bottom: 10px;">
    Welcome to Prairie Market
  </h1>

  <p style="font-size: 18px; color: #666;">
    Discover quality products for every lifestyle.
  </p>

</div>

<%= form_with url: root_path, method: :get, local: true do %>

  <%= text_field_tag :search,
                     params[:search],
                     placeholder: "Search products...",
                     style: "padding: 12px; width: 260px; border: 1px solid #aaa; border-radius: 6px; margin: 4px;" %>

  <%= select_tag :category,
                 options_from_collection_for_select(
                   @categories,
                   :id,
                   :name,
                   params[:category]
                 ),
                 include_blank: "All Categories",
                 style: "padding: 12px; border: 1px solid #aaa; border-radius: 6px; margin: 4px;" %>

  <%= select_tag :sort,
                 options_for_select(
                   [
                     ["Recently Added", "recently_added"],
                     ["Recently Updated", "recently_updated"],
                     ["Name: A to Z", "name_asc"],
                     ["Name: Z to A", "name_desc"],
                     ["Price: Low to High", "price_low"],
                     ["Price: High to Low", "price_high"]
                   ],
                   params[:sort] || "recently_added"
                 ),
                 style: "padding: 12px; border: 1px solid #aaa; border-radius: 6px; margin: 4px;" %>

  <%= submit_tag "Apply",
                 style: "padding: 12px 20px; background-color: #222; color: white; border: none; border-radius: 6px; cursor: pointer; margin: 4px;" %>

  <%= link_to "Clear",
              root_path,
              style: "display: inline-block; padding: 11px 18px; border: 1px solid #333; border-radius: 6px; text-decoration: none; margin: 4px;" %>

<% end %>

<div style="margin-top: 20px; margin-bottom: 20px;">

  <%= link_to "All Products",
              root_path(
                search: params[:search],
                sort: params[:sort]
              ),
              style: "margin: 5px; padding: 10px 16px; display: inline-block; border: 1px solid #333; border-radius: 6px; text-decoration: none;" %>

  <% @categories.each do |category| %>
    <%= link_to category.name,
                root_path(
                  category: category.id,
                  search: params[:search],
                  sort: params[:sort]
                ),
                style: "margin: 5px; padding: 10px 16px; display: inline-block; border: 1px solid #333; border-radius: 6px; text-decoration: none;" %>
  <% end %>

</div>

<div style="margin-bottom: 20px;">
  <% if @products.any? %>

    <p>
      Showing
      <%= @products.offset_value + 1 %>
      to
      <%= @products.offset_value + @products.length %>
      of
      <%= @products.total_count %>
      matching products
    </p>

  <% else %>

    <p>Showing 0 matching products</p>

  <% end %>
</div>

<% if @products.any? %>

  <!-- Product cards -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px;">

    <%= render @products %>

  </div>

  <!-- Kaminari pagination -->
  <% if @products.total_pages > 1 %>

    <div style="text-align: center; margin-top: 35px;">
      <%= paginate @products,
                   params: {
                     search: params[:search],
                     category: params[:category],
                     sort: params[:sort]
                   } %>
    </div>

    <p style="text-align: center; margin-top: 15px;">
      Page <%= @products.current_page %> of <%= @products.total_pages %>
    </p>

  <% end %>

<% else %>

  <div style="text-align: center; padding: 40px; background-color: #f3f3f3; border-radius: 10px;">
    <h3>No products found</h3>

    <p>
      Try another keyword, category, or sorting option.
    </p>

    <%= link_to "Show All Products",
                root_path,
                style: "display: inline-block; padding: 10px 16px; background-color: #222; color: white; text-decoration: none; border-radius: 6px;" %>
  </div>

<% end %>